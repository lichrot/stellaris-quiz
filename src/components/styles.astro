<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Exo+2:wght@400;500;600;700&display=swap");

  :root {
    --bg: #04070d;
    --panel: rgba(9, 18, 28, 0.92);
    --panel-alt: rgba(14, 30, 44, 0.85);
    --line: #25505f;
    --line-hi: #4fd8dc;
    --accent: #4fe3e6;
    --accent-dim: #2a8f9a;
    --good: #6df0b5;
    --gold: #e6c97a;
    --text: #c4dde4;
    --muted: #7f9fa9;
    --glow: 0 0 8px rgba(79, 227, 230, 0.45);
    --font: "Exo 2", "Segoe UI", "Trebuchet MS", system-ui, sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scrollbar-color: var(--accent-dim) #070d14;
  }

  body {
    margin: 0;
    padding: 32px 16px 110px;
    min-height: 100vh;
    font-family: var(--font);
    font-size: 16px;
    line-height: 1.45;
    color: var(--text);
    background-color: var(--bg);
    /* nebula + starfield */
    background-image:
      radial-gradient(1px 1px at 12% 18%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 38% 72%, #cfeaff 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 64% 31%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 83% 85%, #bfe9ff 50%, transparent 51%),
      radial-gradient(1px 1px at 91% 12%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 27% 44%, #9fdcff 50%, transparent 51%),
      radial-gradient(
        ellipse at 20% 0%,
        rgba(30, 90, 120, 0.35),
        transparent 55%
      ),
      radial-gradient(
        ellipse at 90% 100%,
        rgba(70, 40, 120, 0.3),
        transparent 55%
      );
    background-attachment: fixed;
  }

  ::selection {
    background: var(--accent-dim);
    color: #fff;
  }

  /* ---------- main panel ---------- */

  form {
    position: relative;
    max-width: 880px;
    margin: 0 auto;
    padding: 72px 28px 28px;
    background: linear-gradient(
      180deg,
      rgba(14, 30, 44, 0.95),
      var(--panel) 120px
    );
    border: 1px solid var(--line);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.8),
      0 0 40px rgba(79, 227, 230, 0.1),
      inset 0 0 60px rgba(0, 0, 0, 0.5);
  }

  /* title bar (generated, no HTML needed) */
  form::before {
    content: "Тест на аутизм";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    padding: 18px 28px;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    text-shadow: 0 0 10px rgba(230, 201, 122, 0.4);
    background:
      linear-gradient(90deg, rgba(79, 227, 230, 0.18), transparent 70%),
      rgba(4, 10, 16, 0.85);
    border-bottom: 1px solid var(--line-hi);
    box-shadow: 0 1px 12px rgba(79, 227, 230, 0.25);
  }

  /* ---------- question blocks ---------- */

  section {
    position: relative;
    margin: 0 0 22px;
    padding: 18px 20px 20px;
    background: var(--panel-alt);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent-dim);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  section:hover,
  section:focus-within {
    border-color: var(--accent-dim);
    border-left-color: var(--accent);
    box-shadow: 0 0 18px rgba(79, 227, 230, 0.12);
  }

  /* corner brackets */
  section::before,
  section::after {
    content: "";
    position: absolute;
    width: 12px;
    height: 12px;
    pointer-events: none;
    border: 0 solid var(--accent);
    opacity: 0.8;
  }
  section::before {
    top: -1px;
    right: -1px;
    border-top-width: 2px;
    border-right-width: 2px;
  }
  section::after {
    bottom: -1px;
    right: -1px;
    border-bottom-width: 2px;
    border-right-width: 2px;
  }

  /* question headings: first label / p of each section */
  section > label:first-child,
  section > p:first-child {
    display: block;
    margin: 0 0 14px;
    padding-bottom: 10px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--gold);
    border-bottom: 1px solid transparent;
    border-image: linear-gradient(90deg, var(--accent-dim), transparent) 1;
  }

  /* question numbers come from DOM position (questions are shuffled on load) */
  form {
    counter-reset: question;
  }
  section {
    counter-increment: question;
  }

  section > label:first-child::before,
  section > p:first-child::before {
    content: counter(question) ". ";
    color: var(--accent);
  }

  /* ---------- lists ---------- */

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* checkbox lists: multi-column grid */
  ul:not(:has(select)) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 6px 14px;
  }

  /* each checkbox row: the label IS the button, so the whole box is clickable */
  /* li stretches to the tallest cell in its grid row; make it a flex container
     so the label fills it fully (percentage height is unreliable on grid items) */
  ul:has(input[type="checkbox"]) > li {
    display: flex;
  }

  ul:has(input[type="checkbox"]) > li > label {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    cursor: pointer;
    color: var(--text);
    background: rgba(4, 10, 16, 0.55);
    border: 1px solid rgba(37, 80, 95, 0.6);
    user-select: none;
    transition:
      background 0.15s,
      border-color 0.15s,
      color 0.15s;
  }

  ul:has(input[type="checkbox"]) > li > label:hover {
    background: rgba(79, 227, 230, 0.08);
    border-color: var(--accent-dim);
  }

  ul:has(input[type="checkbox"]) > li > label:has(input:checked) {
    color: #fff;
    background: rgba(79, 227, 230, 0.14);
    border-color: var(--accent);
    box-shadow: inset 0 0 10px rgba(79, 227, 230, 0.15);
  }

  ul:has(input[type="checkbox"]) > li > label:has(input:focus-visible) {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  li:has(> select) > label {
    color: var(--text);
  }

  /* mapping lists: label left, dropdown right */
  ul:has(select) {
    display: grid;
    gap: 8px;
  }

  li:has(> select) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    padding: 6px 10px;
    background: rgba(4, 10, 16, 0.55);
    border: 1px solid rgba(37, 80, 95, 0.6);
  }

  li:has(> select):hover,
  li:has(> select:focus) {
    border-color: var(--accent-dim);
    background: rgba(79, 227, 230, 0.06);
  }

  /* ---------- checkbox ---------- */

  input[type="checkbox"] {
    -webkit-appearance: none;
    appearance: none;
    flex: none;
    width: 20px;
    height: 20px;
    margin: 0;
    cursor: pointer;
    background: #050c13;
    border: 1px solid var(--accent-dim);
    /* chamfered corners */
    clip-path: polygon(
      4px 0,
      100% 0,
      100% calc(100% - 4px),
      calc(100% - 4px) 100%,
      0 100%,
      0 4px
    );
    transition:
      background 0.15s,
      border-color 0.15s;
  }

  input[type="checkbox"]:checked {
    background-color: var(--accent-dim);
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20'><path d='M4.5 10.5l3.5 3.5 7.5-8' fill='none' stroke='%23eafffe' stroke-width='2.4' stroke-linecap='square'/></svg>");
    background-size: 100% 100%;
    filter: drop-shadow(0 0 4px var(--accent));
  }

  input[type="checkbox"]:focus-visible {
    outline: none;
  }

  /* ---------- select ---------- */

  select {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    padding: 8px 36px 8px 12px;
    font: inherit;
    color: var(--text);
    cursor: pointer;
    background-color: #050c13;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 8'><path d='M1 1l5 5 5-5' fill='none' stroke='%234fe3e6' stroke-width='2'/></svg>");
    background-repeat: no-repeat;
    background-position: right 12px center;
    background-size: 12px 8px;
    border: 1px solid var(--accent-dim);
    border-radius: 0;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }

  select:hover {
    border-color: var(--accent);
  }

  select:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: var(--glow);
  }

  select:has(option[value=""]:checked) {
    color: var(--muted);
  }

  option {
    background: #07111a;
    color: var(--text);
  }

  /* ---------- text input ---------- */

  input[type="text"] {
    display: block;
    width: 100%;
    padding: 10px 12px;
    font: inherit;
    color: #fff;
    background: rgba(3, 8, 13, 0.8);
    border: 1px solid var(--line);
    border-bottom: 2px solid var(--accent-dim);
    border-radius: 0;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }

  input[type="text"]::placeholder {
    color: var(--muted);
  }

  input[type="text"]:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: var(--glow);
  }

  /* ---------- floating finish button ---------- */

  #finish {
    position: fixed;
    right: max(20px, env(safe-area-inset-right));
    bottom: max(20px, env(safe-area-inset-bottom));
    z-index: 10;
    padding: 12px 28px;
    font: inherit;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    cursor: pointer;
    background: linear-gradient(180deg, #123647, #08202c);
    border: 1px solid var(--accent);
    border-radius: 0;
    box-shadow:
      inset 0 0 12px rgba(79, 227, 230, 0.2),
      0 0 12px rgba(79, 227, 230, 0.25),
      0 6px 20px rgba(0, 0, 0, 0.6);
    transition:
      color 0.15s,
      background 0.15s,
      border-color 0.15s,
      box-shadow 0.15s;
  }

  #finish:hover {
    color: #fff;
    background: linear-gradient(180deg, #1b5468, #0d3242);
    box-shadow:
      inset 0 0 16px rgba(79, 227, 230, 0.35),
      0 0 20px rgba(79, 227, 230, 0.45),
      0 6px 20px rgba(0, 0, 0, 0.6);
  }

  #finish:active {
    background: linear-gradient(180deg, #08202c, #0d3242);
    transform: translateY(1px);
  }

  #finish:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }

  /* ---------- floating timer (top right) ---------- */

  #timer {
    position: fixed;
    top: max(16px, env(safe-area-inset-top));
    right: max(20px, env(safe-area-inset-right));
    z-index: 10;
    min-width: 112px;
    padding: 8px 18px;
    font-size: 22px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.12em;
    text-align: center;
    color: var(--muted);
    background: rgba(4, 10, 16, 0.88);
    border: 1px solid var(--line);
    box-shadow:
      0 0 14px rgba(79, 227, 230, 0.12),
      0 6px 20px rgba(0, 0, 0, 0.6);
    pointer-events: none;
    transition:
      color 0.2s,
      border-color 0.2s,
      box-shadow 0.2s;
  }

  #timer[data-state="running"] {
    color: var(--accent);
    border-color: var(--accent-dim);
    text-shadow: 0 0 8px rgba(79, 227, 230, 0.5);
  }

  #timer[data-state="stopped"] {
    color: var(--gold);
    border-color: var(--gold);
    box-shadow:
      0 0 16px rgba(230, 201, 122, 0.3),
      0 6px 20px rgba(0, 0, 0, 0.6);
    text-shadow: 0 0 8px rgba(230, 201, 122, 0.45);
  }

  /* ---------- toast ---------- */

  #toast {
    position: fixed;
    left: 50%;
    bottom: max(84px, calc(env(safe-area-inset-bottom) + 72px));
    z-index: 11;
    width: max-content;
    max-width: min(92vw, 460px);
    padding: 14px 20px;
    line-height: 1.4;
    color: var(--text);
    text-align: center;
    cursor: pointer;
    background: rgba(8, 26, 36, 0.96);
    border: 1px solid var(--good);
    border-left-width: 4px;
    box-shadow:
      0 0 18px rgba(109, 240, 181, 0.25),
      0 8px 28px rgba(0, 0, 0, 0.7);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 12px);
    transition:
      opacity 0.25s,
      transform 0.25s,
      visibility 0.25s;
  }

  #toast[data-visible="true"] {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  #toast[data-kind="error"] {
    border-color: #ff8a7a;
    box-shadow:
      0 0 18px rgba(255, 138, 122, 0.25),
      0 8px 28px rgba(0, 0, 0, 0.7);
  }

  /* ---------- scrollbar (WebKit) ---------- */

  ::-webkit-scrollbar {
    width: 12px;
  }
  ::-webkit-scrollbar-track {
    background: #070d14;
  }
  ::-webkit-scrollbar-thumb {
    background: var(--accent-dim);
    border: 2px solid #070d14;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--accent);
  }

  /* ---------- small screens ---------- */

  @media (max-width: 600px) {
    form {
      padding: 64px 14px 20px;
    }
    form::before {
      font-size: 16px;
      padding: 16px 14px;
    }
    section {
      padding: 14px 12px 16px;
    }
    #finish {
      right: 12px;
      bottom: 12px;
      padding: 10px 18px;
      font-size: 13px;
      letter-spacing: 0.1em;
    }
    #timer {
      top: 10px;
      right: 12px;
      min-width: 88px;
      padding: 6px 12px;
      font-size: 17px;
    }
    #toast {
      bottom: 70px;
    }
    ul:not(:has(select)) {
      grid-template-columns: 1fr;
    }
    li:has(> select) {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
    }
  }

  /* ---------- multi-field open questions (several text inputs per question) ---------- */

  ul:has(input[type="text"]) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px 14px;
  }

  ul:has(input[type="text"]) > li > label {
    display: block;
    margin-bottom: 4px;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  ul:has(input[type="text"]) > li:focus-within > label {
    color: var(--accent);
  }
</style>
