---
import Body from "../components/body.astro";
import Script from "../components/script.astro";
import Styles from "../components/styles.astro";

import favicon from "../assets/favicon.ico";
import og from "../assets/og.jpg";

const url = Astro.url;
const title = "Тест на аутизм";
const desc = "Тест на расстройство аутистического спектра";
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={favicon} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={url} />
    <meta name="robots" content="index, follow, nosnippet" />
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:site_name" content={title} />
    <meta property="og:image" content={og.src} />
    <meta property="og:image:type" content={`image/${og.format}`} />
    <meta property="og:image:width" content={og.width as any as string} />
    <meta property="og:image:height" content={og.height as any as string} />
    <meta property="og:image:alt" content="OpenGraph" />
    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={og.src} />
  </head>
  <Body />
</html>
<Script />
<Styles />
